local tracked = {}
local COLOR = {
    Musuh = Color3.fromRGB(255, 60, 60),
    Pemain = Color3.fromRGB(0, 200, 255),
    Item = Color3.fromRGB(255, 220, 60),
    Kunci = Color3.fromRGB(60, 255, 120),
    Ruby = Color3.fromRGB(255, 50, 200),
    Barang = Color3.fromRGB(255, 150, 40),
}

local NAMES = {
    {"kunci", "KUNCI", "Kunci"},
    {"key", "KUNCI", "Kunci"},
    {"ruby", "RUBY", "Ruby"},
    {"rubby", "RUBY", "Ruby"},
    {"rubi", "RUBY", "Ruby"},
    {"ayam", "AYAM", "Barang"},
    {"minyak", "MINYAK", "Barang"},
    {"kode", "KODE", "Barang"},
    {"code", "KODE", "Barang"},
}

local BLOCK = {"kayu", "wood"}

local function blocked(s)
    if not s or s == "" then return false end
    s = s:lower()
    for _, b in ipairs(BLOCK) do
        if s:find(b, 1, true) then return true end
    end
    return false
end

local function match(s)
    if not s or s == "" then return nil end
    s = s:lower()
    if s:find("keypad", 1, true) or s:find("keyboard", 1, true) then return nil end
    for _, n in ipairs(NAMES) do
        if s:find(n[1], 1, true) then return n[2], n[3] end
    end
    return nil
end

local function getPart(o)
    if o:IsA("BasePart") then return o end
    return o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true)
end

local function dupAncestor(o, kind)
    local p = o.Parent
    while p and p ~= workspace do
        if tracked[p] and tracked[p].kind == kind then return true end
        p = p.Parent
    end
    return false
end

local function mine(o)
    local c = lp.Character
    if c and o:IsDescendantOf(c) then return true end
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp and o:IsDescendantOf(bp) then return true end
    return false
end

local function mk(target, kind, name, prompt)
    if tracked[target] or dupAncestor(target, kind) or mine(target) then return end
    local part = getPart(target)
    if not part then return end
    local color = COLOR[kind]
    local h
    if kind ~= "Item" then
        h = Instance.new("Highlight")
        h.Adornee = target
        h.FillColor = color
        h.OutlineColor = color
        h.FillTransparency = 0.5
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = holder
    end
    local b = Instance.new("BillboardGui")
    b.Adornee = part
    b.Size = UDim2.fromOffset(130, 28)
    b.StudsOffset = Vector3.new(0, 3, 0)
    b.AlwaysOnTop = true
    b.Parent = holder
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.TextColor3 = color
    t.TextStrokeTransparency = 0
    t.TextScaled = true
    t.Font = Enum.Font.GothamBold
    t.Text = name
    t.Parent = b
    tracked[target] = {h = h, b = b, t = t, part = part, kind = kind, name = name, prompt = prompt}
end

local function scan(o)
    if o:IsA("Humanoid") then
        local m = o.Parent
        if m and m:IsA("Model") and m ~= lp.Character then
            local pl = Players:GetPlayerFromCharacter(m)
            if pl then
                mk(m, "Pemain", pl.DisplayName)
            else
                mk(m, "Musuh", m.Name)
            end
        end
    elseif o:IsA("ProximityPrompt") or o:IsA("ClickDetector") then
        local p = o.Parent
        if p and p:IsA("BasePart") then
            local ot = o:IsA("ProximityPrompt") and o.ObjectText or ""
            local at = o:IsA("ProximityPrompt") and o.ActionText or ""
            local pn = p.Parent and p.Parent.Name or ""
            if blocked(p.Name) or blocked(pn) or blocked(ot) or blocked(at) then return end
            local label, kind = match(p.Name)
            if not label then label, kind = match(pn) end
            if not label then label, kind = match(ot) end
            if not label then label, kind = match(at) end
            if label then
                mk(p, kind, label, o)
            else
                mk(p, "Item", (ot ~= "" and ot) or p.Name, o)
            end
        end
    elseif o:IsA("BasePart") or o:IsA("Model") or o:IsA("Tool") then
        if blocked(o.Name) then return end
        local label, kind = match(o.Name)
        if not label then return end
        if o:FindFirstChildOfClass("Humanoid") then return end
        mk(o, kind, label)
    end
end

for _, o in ipairs(workspace:GetDescendants()) do
    pcall(scan, o)
end
table.insert(conns, workspace.DescendantAdded:Connect(function(o)
    task.defer(function() pcall(scan, o) end)
end))

task.spawn(function()
    while gui.Parent do
        pcall(function()
            local c = lp.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            local near = math.huge
            for k, v in pairs(tracked) do
                local gone = (not k:IsDescendantOf(workspace)) or mine(k) or (v.prompt and not v.prompt.Parent)
                if gone then
                    if v.h then v.h:Destroy() end
                    v.b:Destroy()
                    tracked[k] = nil
                else
                    local d = nil
                    if hrp and v.part.Parent then
                        d = math.floor((v.part.Position - hrp.Position).Magnitude)
                    end
                    local on = CFG[v.kind]
                    local pr = v.prompt
                    if pr and pr:IsA("ProximityPrompt") and not pr.Enabled then on = false end
                    if v.h then v.h.Enabled = on end
                    v.b.Enabled = on
                    if on and d then
                        v.t.Text = v.name .. " [" .. d .. "m]"
                    end
                    if v.kind == "Musuh" and d and d < near then near = d end
                end
            end
            if CFG.Alarm and near <= ALARM_JARAK then
                alarm.Text = "BAHAYA! MUSUH " .. near .. "m"
                alarm.Visible = true
            else
                alarm.Visible = false
            end
        end)
        task.wait(0.25)
    end
end)

-- ===== LARI CEPAT =====
table.insert(conns, RS.Heartbeat:Connect(function()
    local c = lp.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if SPEED.on then
        if not SPEED.was or SPEED.hum ~= h then
            SPEED.was = true
            SPEED.hum = h
            SPEED.base = h.WalkSpeed
        end
        local target = SPEED.base * SPEED.mult
        if h.WalkSpeed ~= target then h.WalkSpeed = target end
    elseif SPEED.was then
        SPEED.was = false
        if SPEED.hum then SPEED.hum.WalkSpeed = SPEED.base end
    end
end))

-- ===== TEMBUS TEMBOK (Noclip) =====
local ncOrig = {}
local ncWas = false
local function restoreNoclip()
    for part, val in pairs(ncOrig) do
        pcall(function()
            if part and part.Parent then part.CanCollide = val end
        end)
    end
    ncOrig = {}
end
table.insert(conns, RS.Stepped:Connect(function()
    local c = lp.Character
    if CFG.Noclip then
        ncWas = true
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                if ncOrig[p] == nil then ncOrig[p] = p.CanCollide end
                p.CanCollide = false
            end
        end
    elseif ncWas then
        ncWas = false
        restoreNoclip()
    end
end))

