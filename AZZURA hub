local pages, tabBtns = {}, {}
local function showPage(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do
        b.BackgroundColor3 = (n == name) and C.accent or C.side
        b.TextColor3 = (n == name) and Color3.new(1, 1, 1) or C.dim
    end
end

local function newTab(name, label, order, canvasH)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -12, 0, 30)
    b.Position = UDim2.new(0, 6, 0, 8 + (order - 1) * 36)
    b.BackgroundColor3 = C.side
    b.Text = label
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.TextColor3 = C.dim
    b.Parent = side
    Instance.new("UICorner", b)
    tabBtns[name] = b

    local p = Instance.new("ScrollingFrame")
    p.Size = UDim2.new(1, -104, 1, -9)
    p.Position = UDim2.new(0, 100, 0, 5)
    p.BackgroundTransparency = 1
    p.BorderSizePixel = 0
    p.ScrollBarThickness = 3
    p.CanvasSize = UDim2.new(0, 0, 0, canvasH)
    p.Visible = false
    p.Parent = body
    pages[name] = p

    b.MouseButton1Click:Connect(function() showPage(name) end)
    return p
end

